# Email (optional — console backend used if not set)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Smart Crops <noreply@smartcrops.tz>

# Notify Africa OTP delivery
NOTIFY_SMS_KEY=ntfy_d5f435d163d5b98b5a849c15ffc6d252f244f5d35b90bf2edaf89770470e9b30
NOTIFY_WHATSAPP_KEY=ntfy_2ae8d006cb99d05f254d8c02f32cfe6dbdad354514063ab467abe18d489feea1
